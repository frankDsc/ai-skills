  "actions": [
    {
      "id": "prepare",
      "label": "生成模拟源数据",
      "desc": "1,200 笔虚构订单、应用配置、12 个合成附件",
      "flow": [
        "source"
      ],
      "cmd": "python3 engine.py --action prepare"
    },
    {
      "id": "full",
      "label": "执行全量搬迁",
      "desc": "复制应用、订单库与附件，保留源端服务",
      "flow": [
        "source",
        "transfer",
        "target"
      ],
      "cmd": "python3 engine.py --action full"
    },
    {
      "id": "change",
      "label": "产生源端增量",
      "desc": "新增 25 笔、更新 10 笔、删除 5 笔订单及附件变更",
      "flow": [
        "source"
      ],
      "cmd": "python3 engine.py --action change"
    },
    {
      "id": "sync",
      "label": "执行差异补迁",
      "desc": "按主键比对订单、按 SHA-256 比对文件，处理删除",
      "flow": [
        "source",
        "transfer",
        "target"
      ],
      "cmd": "python3 engine.py --action sync"
    },
    {
      "id": "freeze",
      "label": "冻结源端写入",
      "desc": "进入只读割接窗口，阻止新的源端模拟交易",
      "flow": [
        "source"
      ],
      "cmd": "python3 engine.py --action freeze"
    },
    {
      "id": "verify",
      "label": "验证割接门禁",
      "desc": "对比全部订单内容、文件摘要，并做只读业务探针",
      "flow": [
        "source",
        "transfer",
        "target"
      ],
      "cmd": "python3 engine.py --action verify"
    },
    {
      "id": "cutover",
      "label": "切换演示业务",
      "desc": "门禁通过才将本实验逻辑路由切至目标端；保留只读回退窗",
      "flow": [
        "transfer",
        "target"
      ],
      "cmd": "python3 engine.py --action cutover"
    },
    {
      "id": "rollback",
      "label": "执行只读回退",
      "desc": "目标未产生新写入且源目标仍一致时才允许回退",
      "flow": [
        "target",
        "transfer",
        "source"
      ],
      "cmd": "python3 engine.py --action rollback"
    },
    {
      "id": "target_write",
      "label": "验证写后回退拦截",
      "desc": "在目标写入一笔虚构订单，验证简单回切被禁止",
      "flow": [
        "target"
      ],
      "cmd": "python3 engine.py --action target_write"
    }
  ],
  "note": "清单为固定引擎及架构模型的导出。使用独立 app.py；不是通用 SSH GUI 的已部署配置。",
  "network_transfer": {
    "source": "local synthetic file",
    "target": "dedicated ECS via SFTP",
    "payload_bytes": 134217728,
    "status_poll_seconds": 1,
    "integrity": "target length and SHA-256",
    "measurement": "actual client bytes and monotonic time"
  }
